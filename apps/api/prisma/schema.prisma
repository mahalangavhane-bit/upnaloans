generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ApplicationStatus {
  LEAD
  PROFILE_CREATED
  APPLICATION_SUBMITTED
  ELIGIBILITY_CHECK
  LENDER_MATCHED
  OFFER_PRESENTED
  CUSTOMER_SELECTED
  DOCUMENT_COLLECTION
  KYC
  LENDER_SUBMITTED
  UNDER_REVIEW
  APPROVED
  SANCTIONED
  DISBURSED
}

model User {
  id        String     @id @default(uuid())
  email     String?     @unique
  phone     String?    @unique
  firstName String?
  lastName  String?
  role UserRole @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  leads     Lead[]
  auditLogs AuditLog[]
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?            @relation(fields: [userId], references: [id])
  profile      CustomerProfile?
  leads        Lead[]
  applications Application[]
}

model CustomerProfile {
  id         String @id @default(uuid())
  customerId String @unique

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  city      String?
  state     String?
  pincode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model Lead {
  id         String     @id @default(uuid())
  customerId String?
  ownerId    String?
  status     LeadStatus @default(NEW)

  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  owner    User?     @relation(fields: [ownerId], references: [id])

  applications Application[]
}

model Application {
  id         String            @id @default(uuid())
  customerId String
  leadId     String?
  status     ApplicationStatus @default(LEAD)

  loanType String?
  amount   Decimal? @db.Decimal(15, 2)
  tenure   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  lead     Lead?    @relation(fields: [leadId], references: [id])

  documents         Document[]
  statusHistory     ApplicationStatusHistory[]
  eligibilityChecks EligibilityCheck[]
  loanOffers        LoanOffer[]
  auditLogs         AuditLog[]
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  status        ApplicationStatus
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
}

enum LenderStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Lender {
  id     String       @id @default(uuid())
  name   String
  code   String       @unique
  status LenderStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          LenderProduct[]
  rules             LenderRule[]
  eligibilityChecks EligibilityCheck[]
  loanOffers        LoanOffer[]
}

model LenderProduct {
  id       String        @id @default(uuid())
  lenderId String
  name     String
  code     String
  status   ProductStatus @default(ACTIVE)

  minAmount Decimal? @db.Decimal(15, 2)
  maxAmount Decimal? @db.Decimal(15, 2)
  minTenure Int?
  maxTenure Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lender            Lender             @relation(fields: [lenderId], references: [id])
  rules             LenderRule[]
  eligibilityChecks EligibilityCheck[]
  loanOffers        LoanOffer[]

  @@unique([lenderId, code])
  @@index([lenderId])
}

model LenderRule {
  id        String  @id @default(uuid())
  lenderId  String
  productId String?

  name      String
  version   Int     @default(1)
  isActive  Boolean @default(true)

  ruleType   String
  ruleConfig Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lender  Lender         @relation(fields: [lenderId], references: [id])
  product LenderProduct? @relation(fields: [productId], references: [id])

  versions LenderRuleVersion[]

  @@index([lenderId])
  @@index([productId])
  @@index([lenderId, isActive])
}

model LenderRuleVersion {
  id         String   @id @default(uuid())
  ruleId     String
  version    Int
  ruleType   String
  ruleConfig Json
  createdAt  DateTime @default(now())

  rule LenderRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, version])
  @@index([ruleId, version])
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  ERROR
}

model EligibilityCheck {
  id            String  @id @default(uuid())
  applicationId String
  lenderId      String
  productId     String?

  status        EligibilityStatus @default(PENDING)
  ruleVersion   Int?
  details       Json?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application    @relation(fields: [applicationId], references: [id])
  lender      Lender         @relation(fields: [lenderId], references: [id])
  product     LenderProduct? @relation(fields: [productId], references: [id])

  @@index([applicationId])
  @@index([lenderId])
  @@index([productId])
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}
enum OfferStatus {
  GENERATED
  PRESENTED
  SELECTED
  REJECTED
  EXPIRED
}

model LoanOffer {
  id            String  @id @default(uuid())
  applicationId String
  lenderId      String
  productId     String?

  status OfferStatus @default(GENERATED)

  amount       Decimal? @db.Decimal(15, 2)
  interestRate Decimal? @db.Decimal(5, 2)
  tenure       Int?
  monthlyEmi   Decimal? @db.Decimal(15, 2)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application    @relation(fields: [applicationId], references: [id])
  lender      Lender         @relation(fields: [lenderId], references: [id])
  product     LenderProduct? @relation(fields: [productId], references: [id])

  @@index([applicationId])
  @@index([lenderId])
  @@index([productId])
  @@index([applicationId, status])
}
model Document {
  id            String         @id @default(uuid())
  applicationId String
  documentType  String
  fileName      String
  fileUrl       String
  status        DocumentStatus @default(UPLOADED)

  uploadedAt DateTime  @default(now())
  verifiedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([applicationId, documentType])
  @@index([applicationId, status])
}
model AuditLog {
  id            String   @id @default(uuid())
  applicationId String?
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  application Application? @relation(fields: [applicationId], references: [id])
  actor       User?        @relation(fields: [actorUserId], references: [id])

  @@index([applicationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}